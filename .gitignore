# ═══════════════════════════════════════════════════════════════
#  SIPEDULI — Crime Reporting System
#  .gitignore — dioptimasi untuk kolaborasi tim + Claude Code /init
#
#  ATURAN UMUM:
#  ✅ Di-commit  → source code, config template, schema, docs
#  ❌ Di-ignore  → credentials, venv, node_modules, build, model besar
# ═══════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────
#  RAHASIA & ENVIRONMENT VARIABLES
# ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.staging
.env.test
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Kunci & sertifikat
*.pem
*.key
*.crt
*.p12


# ───────────────────────────────────────────────────────────────
#  PYTHON — VIRTUAL ENVIRONMENT
#  Tiap anggota tim buat venv sendiri: python -m venv env && pip install -r requirements.txt
# ───────────────────────────────────────────────────────────────
env/
venv/
venv*/
.venv/
ENV/
.virtualenv/

# Cache & bytecode Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Packaging
*.egg
*.egg-info/
dist/
build/
.eggs/
*.so
*.whl


# ───────────────────────────────────────────────────────────────
#  PYTHON — TOOLS & TESTING
# ───────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/


# ───────────────────────────────────────────────────────────────
#  MACHINE LEARNING — MODEL ARTIFACTS
#  Regenerate dari notebooks/02_modeling.ipynb
#  Distribusi via MLflow atau Google Drive
# ───────────────────────────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.bin

# MLflow tracking lokal
mlflow.db
mlruns/
mlflow/

# Log training
backend/ml/notebooks/logs.log
logs.log


# ───────────────────────────────────────────────────────────────
#  DATA — FILE BESAR
#  Simpan di shared storage (Google Drive/S3), bukan di git
# ───────────────────────────────────────────────────────────────
data/*.csv
data/*.parquet
data/*.xlsx
data/*.xls
data/*.zip
data/*.tar.gz

# File data yang nyasar ke root (harusnya di data/)
/*.csv
/*.parquet
/*.xlsx


# ───────────────────────────────────────────────────────────────
#  DOCS — EDA VISUALIZATIONS
#  PNG hasil notebook, bukan source code
# ───────────────────────────────────────────────────────────────
docs/*.png
docs/*.jpg
docs/*.jpeg


# ───────────────────────────────────────────────────────────────
#  NODE.JS / NEXT.JS
# ───────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# Build output Next.js
frontend/.next/
frontend/out/
frontend/build/

# Cache
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnp.*
*.tsbuildinfo


# ───────────────────────────────────────────────────────────────
#  DATABASE & STORAGE LOKAL
# ───────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# Docker named volumes
postgres_data/
mlflow_artifacts/
model_artifacts/


# ───────────────────────────────────────────────────────────────
#  JUPYTER NOTEBOOKS
#  Notebook (.ipynb) di-commit, checkpoint tidak
# ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/


# ───────────────────────────────────────────────────────────────
#  LOG FILES
# ───────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ───────────────────────────────────────────────────────────────
#  OS — SYSTEM FILES
# ───────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
._*

# Windows
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~


# ───────────────────────────────────────────────────────────────
#  IDE — EDITOR FILES
# ───────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# VS Code — ignore settings personal, keep rekomendasi ekstensi
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


# ───────────────────────────────────────────────────────────────
#  TEMPORARY & OUTPUT FILES
# ───────────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
tmp/
temp/

# File output sementara (jangan di-commit)
struktur.txt


# ───────────────────────────────────────────────────────────────
#  CLAUDE CODE — TOKEN OPTIMIZATION
#  File yang tidak perlu dibaca Claude Code saat /init
# ───────────────────────────────────────────────────────────────
# Lock files (di-regenerate otomatis)
package-lock.json
yarn.lock
poetry.lock

# Font files (binary)
*.woff
*.woff2
*.ttf
*.otf
*.eot

# ⚠ CATATAN SVG: TIDAK di-ignore secara global
# SVG di frontend/app/ adalah source code komponen (peta Indonesia, icon)
# Hanya ignore SVG di public assets jika ada:
# frontend/public/**/*.svg

# Image binary (EDA docs sudah di-cover di section docs/ di atas)
# Tidak ignore *.png/*.jpg secara global karena bisa ada di source code

# Compiled/generated assets
*.min.js
*.min.css
*.map
frontend/public/

# Build artifacts backend
backend/app/ml/models/